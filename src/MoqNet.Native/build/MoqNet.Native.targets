<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' Or '$(TargetFramework)' == 'netstandard2.1'">
    <None Include="$(MSBuildThisFileDirectory)../runtimes/win-x64/native/moqnet_ffi.dll"
          Condition="Exists('$(MSBuildThisFileDirectory)../runtimes/win-x64/native/moqnet_ffi.dll')">
      <Link>moqnet_ffi.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(MSBuildThisFileDirectory)../runtimes/win-arm64/native/moqnet_ffi.dll"
          Condition="Exists('$(MSBuildThisFileDirectory)../runtimes/win-arm64/native/moqnet_ffi.dll')">
      <Link>moqnet_ffi.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(MSBuildThisFileDirectory)../runtimes/linux-x64/native/libmoqnet_ffi.so"
          Condition="Exists('$(MSBuildThisFileDirectory)../runtimes/linux-x64/native/libmoqnet_ffi.so')">
      <Link>libmoqnet_ffi.so</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(MSBuildThisFileDirectory)../runtimes/linux-arm64/native/libmoqnet_ffi.so"
          Condition="Exists('$(MSBuildThisFileDirectory)../runtimes/linux-arm64/native/libmoqnet_ffi.so')">
      <Link>libmoqnet_ffi.so</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(MSBuildThisFileDirectory)../runtimes/osx-x64/native/libmoqnet_ffi.dylib"
          Condition="Exists('$(MSBuildThisFileDirectory)../runtimes/osx-x64/native/libmoqnet_ffi.dylib')">
      <Link>libmoqnet_ffi.dylib</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(MSBuildThisFileDirectory)../runtimes/osx-arm64/native/libmoqnet_ffi.dylib"
          Condition="Exists('$(MSBuildThisFileDirectory)../runtimes/osx-arm64/native/libmoqnet_ffi.dylib')">
      <Link>libmoqnet_ffi.dylib</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
